# Supabase (Project Settings → API) — required
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Sentry (optional — the app no-ops without a DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Sentry CLI (optional — source-map uploads during EAS builds; not read by the app)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
